# ==========================================
# Database Configuration
# ==========================================

# For PRODUCTION (PostgreSQL/MySQL):
# Use DB_ENGINE, DB_USERNAME, DB_PASS, DB_HOST, DB_PORT, DB_NAME
DB_ENGINE=postgresql
DB_USERNAME=dbuser
DB_PASS=dbpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dashboardsonar

# For DEVELOPMENT with PostgreSQL/MySQL (auto-detected):
# If DB_ENGINE and DB_USERNAME are set in Development mode,
# the system will automatically use PostgreSQL/MySQL instead of SQLite
# Example for Development with PostgreSQL:
# DB_ENGINE=postgresql
# DB_USERNAME=postgres
# DB_PASS=your_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dashboardsonar_dev

# For DEVELOPMENT/TESTING (SQLite - default):
# Use SQLITE_DB_FILE instead of DB_NAME
# If DB_ENGINE is not set or DB_USERNAME is not set, SQLite will be used
# SQLITE_DB_FILE=db.sqlite3        # For Development
# SQLITE_DB_FILE=testdb.sqlite3    # For Testing

# ==========================================
# Security
# ==========================================

# Secret key for session encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-in-production

# ==========================================
# Application Settings
# ==========================================

# Flask application entry point
FLASK_APP=run.py

# Debug mode (True for development, False for production)
# IMPORTANT: FLASK_DEBUG and DEBUG must match
# For development: FLASK_DEBUG=1 and DEBUG=True
# For production: FLASK_DEBUG=0 and DEBUG=False
FLASK_DEBUG=0
DEBUG=False
TESTING=False

# Server configuration
HOST=127.0.0.1
PORT=5000

# Number of days for metrics comparison
DAYS_COMPARISON=15

# ==========================================
# Assets
# ==========================================

# Root path for static assets
ASSETS_ROOT=/static/assets

# ==========================================
# Logging
# ==========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==========================================
# Data Files Configuration
# ==========================================

# Directory containing CSV data files
DATA_DIR=./datos

# CSV filenames (can be customized per environment)
METRICAS_FILENAME=metricas.csv
HISTORICO_FILENAME=historico.csv
PROVEEDORES_FILENAME=proveedores.csv
