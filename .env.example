# ==========================================
# Database Configuration
# ==========================================

# For PRODUCTION (PostgreSQL/MySQL):
# Use DB_ENGINE, DB_USERNAME, DB_PASS, DB_HOST, DB_PORT, DB_NAME
DB_ENGINE=postgresql
DB_USERNAME=dbuser
DB_PASS=dbpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dashboardsonar

# For DEVELOPMENT/TESTING (SQLite):
# Use SQLITE_DB_FILE instead of DB_NAME
# SQLITE_DB_FILE=db.sqlite3        # For Development
# SQLITE_DB_FILE=testdb.sqlite3    # For Testing

# ==========================================
# Security
# ==========================================

# Secret key for session encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-in-production

# ==========================================
# Application Settings
# ==========================================

# Flask application entry point
FLASK_APP=run.py

# Debug mode (True for development, False for production)
# IMPORTANT: FLASK_DEBUG and DEBUG must match
# For development: FLASK_DEBUG=1 and DEBUG=True
# For production: FLASK_DEBUG=0 and DEBUG=False
FLASK_DEBUG=0
DEBUG=False
TESTING=False

# Server configuration
HOST=127.0.0.1
PORT=5000

# Number of days for metrics comparison
DAYS_COMPARISON=15

# ==========================================
# Assets
# ==========================================

# Root path for static assets
ASSETS_ROOT=/static/assets

# ==========================================
# Logging
# ==========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
