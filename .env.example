# ==========================================
# Database Configuration
# ==========================================

# Database engine: postgresql, mysql, sqlite
DB_ENGINE=postgresql
DB_USERNAME=dbuser
DB_PASS=dbpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dashboardsonar

# ==========================================
# Security
# ==========================================

# Secret key for session encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-in-production

# ==========================================
# Application Settings
# ==========================================

# Flask application entry point
FLASK_APP=run.py

# Debug mode (True for development, False for production)
FLASK_DEBUG=0
DEBUG=False

# Number of days for metrics comparison
DAYS_COMPARISON=15

# ==========================================
# Assets
# ==========================================

# Root path for static assets
ASSETS_ROOT=/static/assets

# ==========================================
# Logging
# ==========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
